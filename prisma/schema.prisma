// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum UserRole {
  ADMIN
  MANAGER
  VIEWER
}

enum MasterType {
  SITE
  ITEM
}

enum ImportSource {
  FILE
  PASTE
}

enum ContractStatus {
  DRAFT
  ACTIVE
  ENDED
  CANCELED
}

enum RevenueSourceType {
  CONTRACT
  MANUAL
  ADJUSTMENT
}

enum RevenueStatus {
  DRAFT
  CONFIRMED
  CANCELED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  SUPERSEDED
}

enum InvoiceDisplayMode {
  AGGREGATED
  ITEMIZED
}

enum MonthlyCloseState {
  OPEN
  CLOSED
}

model User {
  id           String     @id @default(cuid())
  loginId      String     @unique
  name         String
  passwordHash String
  role         UserRole   @default(VIEWER)
  isActive     Boolean    @default(true)
  version      Int        @default(1)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  sessions     Session[]
  auditLogs    AuditLog[] @relation("AuditActor")

  @@index([isActive, role])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorName  String?
  action     String
  entityType String
  entityId   String?
  beforeJson String?
  afterJson  String?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
}

model Site {
  id               String            @id @default(cuid())
  code             String            @unique
  name             String
  customerName     String?
  address          String?
  managerName      String?
  managerContact   String?
  startDate        DateTime?
  endDate          DateTime?
  isActive         Boolean           @default(true)
  memo             String?
  version          Int               @default(1)
  createdById      String
  updatedById      String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  aliases          SiteAlias[]
  contracts        Contract[]
  revenueEntries   RevenueEntry[]
  monthlyMemos     MonthlyMemo[]
  invoiceDocuments InvoiceDocument[]
  monthlyCloses    MonthlyClose[]
  closeReviews     MonthlyCloseExceptionReview[]

  @@index([name])
  @@index([customerName])
  @@index([isActive, name])
}

model SiteAlias {
  id              String @id @default(cuid())
  siteId          String
  alias           String
  normalizedAlias String @unique
  site            Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
}

model Item {
  id                 String         @id @default(cuid())
  code               String         @unique
  name               String
  unit               String
  standardSalesPrice Int            @default(0)
  standardCostPrice  Int            @default(0)
  isActive           Boolean        @default(true)
  memo               String?
  version            Int            @default(1)
  createdById        String
  updatedById        String
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  aliases            ItemAlias[]
  contractLines      ContractLine[]
  revenueEntries     RevenueEntry[]

  @@index([name])
  @@index([isActive, name])
}

model ItemAlias {
  id              String @id @default(cuid())
  itemId          String
  alias           String
  normalizedAlias String @unique
  item            Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

model BusinessSequence {
  key       String   @id
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model ImportBatch {
  id            String       @id @default(cuid())
  masterType    MasterType
  source        ImportSource
  sourceName    String?
  totalRows     Int
  createdRows   Int          @default(0)
  updatedRows   Int          @default(0)
  unchangedRows Int          @default(0)
  errorRows     Int          @default(0)
  actorId       String
  actorName     String
  createdAt     DateTime     @default(now())

  @@index([masterType, createdAt])
}

model Contract {
  id             String         @id @default(cuid())
  contractNo     String         @unique
  siteId         String
  title          String
  startDate      DateTime
  endDate        DateTime
  status         ContractStatus @default(DRAFT)
  memo           String?
  version        Int            @default(1)
  createdById    String
  updatedById    String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  site           Site           @relation(fields: [siteId], references: [id], onDelete: Restrict)
  lines          ContractLine[]
  revenueEntries RevenueEntry[]

  @@index([siteId, status])
  @@index([startDate, endDate])
  @@index([status, updatedAt])
}

model ContractLine {
  id                         String         @id @default(cuid())
  contractId                 String
  itemId                     String
  description                String?
  quantity                   Float
  unit                       String
  standardSalesPriceSnapshot Int
  appliedSalesPrice          Int
  standardCostPriceSnapshot  Int
  appliedCostPrice           Int
  priceOverrideReason        String?
  priceOverriddenById        String?
  priceOverriddenAt          DateTime?
  revenueStartDate           DateTime
  revenueEndDate             DateTime
  isActive                   Boolean        @default(true)
  sortOrder                  Int            @default(0)
  createdById                String
  updatedById                String
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt
  contract                   Contract       @relation(fields: [contractId], references: [id], onDelete: Cascade)
  item                       Item           @relation(fields: [itemId], references: [id], onDelete: Restrict)
  revenueEntries             RevenueEntry[]

  @@index([contractId, isActive, sortOrder])
  @@index([itemId])
  @@index([revenueStartDate, revenueEndDate])
}

model RevenueEntry {
  id                         String               @id @default(cuid())
  siteId                     String
  revenueDate                DateTime
  servicePeriodStart         DateTime?
  servicePeriodEnd           DateTime?
  sourceType                 RevenueSourceType
  contractId                 String?
  contractLineId             String?
  itemId                     String?
  title                      String
  description                String?
  quantity                   Float?
  unit                       String?
  standardSalesPriceSnapshot Int?
  appliedSalesPrice          Int?
  salesAmount                Int
  prorationDays              Int?
  daysInMonth                Int?
  standardCostPriceSnapshot  Int?
  appliedCostPrice           Int?
  costAmount                 Int?
  priceOverrideReason        String?
  status                     RevenueStatus        @default(DRAFT)
  generatedKey               String?              @unique
  confirmedById              String?
  confirmedAt                DateTime?
  canceledById               String?
  canceledAt                 DateTime?
  cancelReason               String?
  version                    Int                  @default(1)
  createdById                String
  updatedById                String
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  currentInvoiceDocumentId   String?
  site                       Site                 @relation(fields: [siteId], references: [id], onDelete: Restrict)
  contract                   Contract?            @relation(fields: [contractId], references: [id], onDelete: Restrict)
  contractLine               ContractLine?        @relation(fields: [contractLineId], references: [id], onDelete: Restrict)
  item                       Item?                @relation(fields: [itemId], references: [id], onDelete: Restrict)
  invoiceLinks               InvoiceRevenueLink[]
  currentInvoiceDocument     InvoiceDocument?     @relation("CurrentInvoiceRevenues", fields: [currentInvoiceDocumentId], references: [id], onDelete: SetNull)

  @@index([revenueDate, status])
  @@index([siteId, revenueDate])
  @@index([sourceType, status])
  @@index([contractId])
  @@index([contractLineId])
  @@index([currentInvoiceDocumentId])
}

model MonthlyMemo {
  id          String   @id @default(cuid())
  siteId      String
  month       String
  content     String
  version     Int      @default(1)
  createdById String
  updatedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, month])
  @@index([month])
  @@index([siteId, updatedAt])
}

model MonthlyClose {
  id             String            @id @default(cuid())
  siteId         String
  month          String
  state          MonthlyCloseState @default(OPEN)
  latestCycleNo  Int               @default(0)
  version        Int               @default(1)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  site           Site              @relation(fields: [siteId], references: [id], onDelete: Restrict)
  cycles         MonthlyCloseCycle[]
  reopens        MonthlyCloseReopen[]

  @@unique([siteId, month])
  @@index([month, state])
  @@index([siteId, updatedAt])
}

model MonthlyCloseCycle {
  id                   String               @id @default(cuid())
  monthlyCloseId       String
  cycleNo              Int
  revenueCount         Int
  totalSalesAmount     Int
  totalCostAmount      Int
  revenueFingerprint   String
  exceptionFingerprint String
  snapshotJson         String
  closedById           String
  closedByName         String
  closedAt             DateTime
  createdAt            DateTime             @default(now())
  monthlyClose         MonthlyClose         @relation(fields: [monthlyCloseId], references: [id], onDelete: Restrict)
  reopens              MonthlyCloseReopen[]
  invoiceDocument      InvoiceDocument?     @relation("InvoiceCloseCycle")

  @@unique([monthlyCloseId, cycleNo])
  @@index([closedAt])
}

model MonthlyCloseReopen {
  id             String            @id @default(cuid())
  monthlyCloseId String
  fromCycleId    String
  reason         String
  reopenedById   String
  reopenedByName String
  reopenedAt     DateTime
  createdAt      DateTime          @default(now())
  monthlyClose   MonthlyClose      @relation(fields: [monthlyCloseId], references: [id], onDelete: Restrict)
  fromCycle      MonthlyCloseCycle @relation(fields: [fromCycleId], references: [id], onDelete: Restrict)

  @@index([monthlyCloseId, reopenedAt])
  @@index([fromCycleId])
}

model MonthlyCloseExceptionReview {
  id             String   @id @default(cuid())
  siteId         String
  month          String
  exceptionKey   String
  fingerprint    String
  reason         String
  reviewedById   String
  reviewedByName String
  reviewedAt     DateTime
  createdAt      DateTime @default(now())
  site           Site     @relation(fields: [siteId], references: [id], onDelete: Restrict)

  @@unique([siteId, month, exceptionKey, fingerprint])
  @@index([month, reviewedAt])
  @@index([siteId, month])
}

model SyncEvent {
  id        Int      @id @default(autoincrement())
  type      String
  entityId  String
  siteId    String?
  month     String?
  actorId   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([type, id])
}

model CompanySetting {
  id                     String   @id
  businessRegistrationNo String
  companyName            String
  representativeName     String
  address                String
  businessType           String
  businessItem           String
  phone                  String
  defaultMessage         String   @default("아래와 같이 공급합니다.")
  version                Int      @default(1)
  createdById            String
  updatedById            String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model InvoiceTemplate {
  id             String   @id @default(cuid())
  name           String
  normalizedName String   @unique
  configJson     String
  version        Int      @default(1)
  createdById    String
  updatedById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([updatedAt])
}

model InvoiceDocument {
  id                             String               @id @default(cuid())
  invoiceNo                      String               @unique
  siteId                         String
  periodStart                    DateTime
  periodEnd                      DateTime
  issueDate                      DateTime
  status                         InvoiceStatus        @default(ISSUED)
  displayMode                    InvoiceDisplayMode
  recipientName                  String
  recipientAddress               String?
  supplierBusinessRegistrationNo String
  supplierCompanyName            String
  supplierRepresentativeName     String
  supplierAddress                String
  supplierBusinessType           String
  supplierBusinessItem           String
  supplierPhone                  String
  supplyMessage                  String
  subtotal                       Int
  taxAmount                      Int
  totalAmount                    Int
  memo                           String?
  templateIdSnapshot             String?
  templateVersionSnapshot        Int?
  templateName                   String?
  templateConfigJson             String?
  version                        Int                  @default(1)
  createdById                    String
  issuedById                     String
  issuedAt                       DateTime
  supersededAt                   DateTime?
  supersededByInvoiceId          String?
  monthlyCloseCycleId            String?              @unique
  createdAt                      DateTime             @default(now())
  updatedAt                      DateTime             @updatedAt
  site                           Site                 @relation(fields: [siteId], references: [id], onDelete: Restrict)
  lines                          InvoiceLine[]
  revenueLinks                   InvoiceRevenueLink[]
  currentRevenueEntries          RevenueEntry[]       @relation("CurrentInvoiceRevenues")
  supersededBy                   InvoiceDocument?      @relation("InvoiceReplacement", fields: [supersededByInvoiceId], references: [id], onDelete: Restrict)
  supersedes                     InvoiceDocument[]     @relation("InvoiceReplacement")
  monthlyCloseCycle              MonthlyCloseCycle?    @relation("InvoiceCloseCycle", fields: [monthlyCloseCycleId], references: [id], onDelete: Restrict)

  @@index([siteId, issueDate])
  @@index([status, issuedAt])
  @@index([periodStart, periodEnd])
  @@index([supersededByInvoiceId])
}

model InvoiceLine {
  id                String               @id @default(cuid())
  invoiceDocumentId String
  itemName          String
  specification     String?
  quantity          Float?
  unit              String?
  unitPrice         Int?
  supplyAmount      Int
  taxAmount         Int
  sortOrder         Int                  @default(0)
  invoiceDocument   InvoiceDocument      @relation(fields: [invoiceDocumentId], references: [id], onDelete: Cascade)
  revenueLinks      InvoiceRevenueLink[]

  @@index([invoiceDocumentId, sortOrder])
}

model InvoiceRevenueLink {
  id                String          @id @default(cuid())
  invoiceDocumentId String
  invoiceLineId     String
  revenueEntryId    String
  invoiceDocument   InvoiceDocument @relation(fields: [invoiceDocumentId], references: [id], onDelete: Cascade)
  invoiceLine       InvoiceLine     @relation(fields: [invoiceLineId], references: [id], onDelete: Cascade)
  revenueEntry      RevenueEntry    @relation(fields: [revenueEntryId], references: [id], onDelete: Restrict)

  @@index([invoiceDocumentId])
  @@index([invoiceLineId])
  @@index([revenueEntryId])
  @@unique([invoiceDocumentId, revenueEntryId])
}

model SystemSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LegacyMigrationBatch {
  id               String   @id @default(cuid())
  fingerprint      String   @unique
  sourceType       String
  sourceName       String?
  totalItems       Int
  totalSites       Int
  totalContracts   Int
  createdItems     Int
  reusedItems      Int
  createdSites     Int
  reusedSites      Int
  createdContracts Int
  skippedContracts Int
  warningCount     Int
  reportJson       String
  actorId          String
  actorName        String
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
}
